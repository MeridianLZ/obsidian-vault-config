{
  "name": "vault-mcp",
  "version": "2.0.0",
  "description": "Read-surface MCP server for the compliance knowledge vault (mcp-read-surface-spec.md v2.0.0)",
  "type": "module",
  "bin": { "vault-mcp": "bin/vault-mcp.mjs" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "start": "node bin/vault-mcp.mjs",
    "test": "node smoke.mjs && node smoke.mjs -c internal && node smoke.mjs -c public",
    "smoke": "node smoke.mjs"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "zod": "^3.25.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
