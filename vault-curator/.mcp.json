{
  "mcpServers": {
    "vault-read": {
      "type": "local",
      "command": "node",
      "args": ["${VAULT_MCP_DIST:-/opt/vault-mcp/dist/index.js}", "--vault", "${VAULT_PATH}", "--clearance", "${VAULT_CLEARANCE:-internal}"],
      "tools": ["*"]
    },
    "curator-gate": {
      "type": "local",
      "command": "node",
      "args": ["gate-server/index.js", "--vault", "${VAULT_PATH}"],
      "tools": ["curator_propose", "curator_status", "curator_report", "curator_invoke"]
    }
  }
}
