{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/guard-curated-paths.sh",
        "matcher": "edit|write|str_replace_editor|create|shell|bash",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/audit-emit.sh",
        "matcher": "edit|write|str_replace_editor|create",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/prompt-injection-scan.sh",
        "timeoutSec": 10
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/session-vault-guide.sh",
        "timeoutSec": 15
      }
    ]
  }
}
